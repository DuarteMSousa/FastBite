@startuml FastBite_Seq_Restaurante_Preparacao
title FastBite - Sequencia: Restaurante aceita, prepara e marca pedido pronto

skinparam shadowing false
actor "Gestor Restaurante" as Manager
participant "Web\nRestaurantOrdersQueueScreen" as Web
participant "GraphQL\nOrderMutations" as GQL
participant "OrderService\n#[Transactional]" as OrderSvc
participant "DeliveryService" as DeliverySvc
participant "OutboxService" as Outbox
participant "Queue" as Queue
database "PostgreSQL" as DB
participant "GatewayWorker" as GW
participant "Mobile Cliente" as Customer
participant "Mobile Estafeta" as Courier

Manager -> Web: aceita pedido pendente
Web -> GQL: mutation acceptOrderByRestaurant(input)
GQL -> OrderSvc: acceptOrderByRestaurant(restaurantId, orderId)
OrderSvc -> DB: valida restaurante e estado
OrderSvc -> DB: transicao PENDING -> CONFIRMED se aplicavel
OrderSvc -> DB: cria ORDER_CONFIRMED
OrderSvc -> Outbox: enqueue ORDER_CONFIRMED
OrderSvc -> DeliverySvc: createDeliveryForOrder(orderId, fee)
DeliverySvc -> DB: cria/obtem delivery PENDING
OrderSvc -> Queue: AssignCourierToDeliveryJob

Queue -> DeliverySvc: assignCourierToDelivery(deliveryId)
DeliverySvc -> DB: procura estafeta AVAILABLE proximo
DeliverySvc -> DB: cria delivery_offer PENDING
DeliverySvc -> Outbox: enqueue JOB_OFFERED
Queue -> GW: publica JOB_OFFERED
GW -> Courier: courier.{courierId}.jobs

Manager -> Web: inicia preparacao
Web -> GQL: mutation startPreparingOrder(input)
GQL -> OrderSvc: startPreparingOrder(...)
OrderSvc -> DB: exige delivery com courier_id atribuido
OrderSvc -> DB: transicao CONFIRMED -> PREPARING
OrderSvc -> DB: cria ORDER_PREPARING
OrderSvc -> Outbox: enqueue ORDER_PREPARING
GW -> Customer: customer.{userId}.orders
GW -> Web: restaurant.{restaurantId}.orders

Manager -> Web: pedido pronto
Web -> GQL: mutation markOrderReady(input)
GQL -> OrderSvc: markOrderReady(...)
OrderSvc -> DB: transicao PREPARING -> READY
OrderSvc -> DB: cria ORDER_READY
OrderSvc -> Outbox: enqueue ORDER_READY
GW -> Customer: customer.{userId}.orders
GW -> Courier: order.{orderId}.tracking / courier jobs

@enduml
