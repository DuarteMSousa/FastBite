@startuml FastBite_Seq_Restaurante_Preparacao
title FastBite - Sequência: Restaurante aceita, prepara e marca pedido pronto

skinparam shadowing false
actor "Gestor Restaurante" as Manager
participant "Web\nRestaurantOrdersQueueScreen" as Web
participant "GraphQL\nOrderMutations" as GQL
participant "OrderService\n#[Transactional]" as OrderSvc
participant "OutboxService" as Outbox
database "PostgreSQL" as DB
participant "GatewayWorker" as GW
participant "Mobile Cliente" as Customer

Manager -> Web: aceita pedido com estafeta atribuído
Web -> GQL: mutation acceptOrderByRestaurant(input)
GQL -> OrderSvc: acceptOrderByRestaurant(restaurantId, orderId)
OrderSvc -> DB: valida restaurante, estado e estafeta atribuído
OrderSvc -> DB: transição COURIER_ASSIGNED -> CONFIRMED
OrderSvc -> DB: cria ORDER_CONFIRMED
OrderSvc -> Outbox: enqueue ORDER_CONFIRMED
GW -> Customer: customer.{userId}.orders
GW -> Web: restaurant.{restaurantId}.orders

Manager -> Web: inicia preparação
Web -> GQL: mutation startPreparingOrder(input)
GQL -> OrderSvc: startPreparingOrder(...)
OrderSvc -> DB: valida que o restaurante já aceitou o pedido
OrderSvc -> DB: transição CONFIRMED -> PREPARING
OrderSvc -> DB: cria ORDER_PREPARING
OrderSvc -> Outbox: enqueue ORDER_PREPARING
GW -> Customer: customer.{userId}.orders
GW -> Web: restaurant.{restaurantId}.orders

Manager -> Web: pedido pronto
Web -> GQL: mutation markOrderReady(input)
GQL -> OrderSvc: markOrderReady(...)
OrderSvc -> DB: transição PREPARING -> READY
OrderSvc -> DB: cria ORDER_READY
OrderSvc -> Outbox: enqueue ORDER_READY
GW -> Customer: customer.{userId}.orders
GW -> Web: restaurant.{restaurantId}.orders

@enduml
