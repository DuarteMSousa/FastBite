@startuml FastBite_Arquitetura
title FastBite — Arquitetura Conceptual em Camadas

skinparam shadowing false
skinparam component {
  BackgroundColor #FAFAFA
  BorderColor #555
  ArrowColor #555
}
skinparam database {
  BackgroundColor #FAFAFA
  BorderColor #555
}

package "Apresentacao" as Pres {
  component "Frontend Web\n(React / Vite)\n[Perfil: Restaurante]" as Web
  component "Frontend Mobile\n(React Native / Expo)\n[Perfis: Cliente + Estafeta]" as Mobile
}

package "API" as API {
  component "GraphQL\n(Lighthouse)" as GQL
  component "WebSocket\n(Workerman /\nGatewayWorker)" as WS
}

package "Aplicacao / Dominio" as Domain {
  component "Services\n(Order, Delivery, Payment,\nCart, Pricing, Routing,\nNotification, Chat, Review,\n... ~24 services)" as Services
  component "State Machines\n(Order, Payment, Delivery)" as SM
  component "AOP / Aspects\n(#[Transactional],\nLogging via ray/aop)" as AOP
}

package "Infraestrutura" as Infra {
  component "Repositories\n(Eloquent)" as Repos
  component "SocketMessageDispatcher\n+ *SocketHandler" as Dispatcher
  component "Events / Listeners /\nOutbox + Jobs" as Events
}

database "PostgreSQL" as DB
database "Queue\n(database driver)" as Queue

Web -down-> GQL : queries / mutations\n(HTTPS)
Web -down-> WS : WebSocket bidirecional
Mobile -down-> GQL : queries / mutations
Mobile -down-> WS : WebSocket bidirecional

GQL -down-> Services : delega
WS -down-> Dispatcher : eventos para clientes
Services -right-> SM : valida transicoes
Services -.right.-> AOP : intercepta
Services -down-> Repos : persistencia
Services -down-> Events : enqueue outbox

Events -down-> Queue : dispatch jobs
Repos -down-> DB : SQL
Events -right-> Dispatcher : DispatchSocketMessage\n(listener)

note right of AOP #LightYellow
  ray/aop com interceptors
  aplicados via attributes
  PHP 8 (#[Transactional])
end note

note right of Events #LightCyan
  Outbox Pattern garante
  atomicidade entre
  persistencia e publicacao
end note

note bottom of SM #PaleGreen
  Tres maquinas de estado
  com validacao rigorosa
  de transicoes (padrao State)
end note

@enduml
