@startuml FastBite_Seq_Checkout
title FastBite - Sequência: Checkout e criação de encomenda

skinparam shadowing false
actor Cliente
participant "Mobile\nCustomerAppScreen" as Mobile
participant "GraphQL\nOrderMutations" as GQL
participant "OrderService\n#[Transactional]" as OrderSvc
participant "OrderPricingService" as Pricing
participant "PaymentRepository" as PayRepo
participant "OutboxService" as Outbox
participant "Queue" as Queue
database "PostgreSQL" as DB
participant "GatewayWorker\nvia PublishOutboxEventJob" as GW

Cliente -> Mobile: finaliza carrinho
Mobile -> GQL: mutation previewCheckout(...)
GQL -> OrderSvc: previewCheckout(userId, cartId, addressId, coupon)
OrderSvc -> DB: carrega carrinho, restaurante e morada
OrderSvc -> Pricing: calcula subtotal, entrega, descontos e total
Pricing --> GQL: CheckoutPreview
GQL --> Mobile: totais e descontos

Cliente -> Mobile: confirma checkout
Mobile -> GQL: mutation checkout(input)
GQL -> OrderSvc: checkoutOrder(userId, CheckoutDTO)
OrderSvc -> DB: begin transaction
OrderSvc -> DB: cria order PENDING, items e address snapshot
OrderSvc -> DB: cria order_discounts quando aplicável

alt pagamento em dinheiro concluido no checkout
  OrderSvc -> PayRepo: cria payment COMPLETED
  OrderSvc -> DB: order_events ORDER_CREATED, ORDER_PAYMENT_COMPLETED
  OrderSvc -> DB: payment_events PAYMENT_CREATED, PAYMENT_COMPLETED
  OrderSvc -> Outbox: enqueue eventos da encomenda
  OrderSvc -> Queue: AssignCourierToDeliveryJob
else pagamento simulado pendente
  OrderSvc -> PayRepo: cria payment PENDING
  OrderSvc -> DB: order_events ORDER_CREATED
  OrderSvc -> DB: payment_events PAYMENT_CREATED
  OrderSvc -> Outbox: enqueue ORDER_CREATED
  OrderSvc -> Queue: ExpirePendingPaymentJob(delay expired_at)
end

OrderSvc -> DB: limpa carrinho
OrderSvc -> DB: commit
GQL --> Mobile: order PENDING + payment

Queue -> GW: PublishOutboxEventJob publica eventos pendentes
GW -> Mobile: customer.{userId}.orders

note over OrderSvc, GW
  A encomenda só fica visível para o restaurante
  quando um estafeta aceita a oferta e o estado passa
  para COURIER_ASSIGNED.
end note

@enduml
