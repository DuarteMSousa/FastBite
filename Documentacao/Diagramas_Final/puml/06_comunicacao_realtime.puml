@startuml FastBite_Realtime
title FastBite — Arquitetura Event-Driven / Comunicacao em Tempo Real

skinparam shadowing false
skinparam component {
  BackgroundColor #FAFAFA
  BorderColor #555
  ArrowColor #555
}

' =======================
' TIPOS DE EVENTOS
' =======================

package "Tipos de Eventos (Backend/app/Enums)" as Enums {
  card "OrderEventType\n----\nORDER_CREATED\nORDER_PAYMENT_COMPLETED\nORDER_CONFIRMED\nORDER_PREPARING\nORDER_READY\nORDER_PICKED_UP\nORDER_OUT_FOR_DELIVERY\nORDER_DELIVERED\nORDER_CANCELLED\nORDER_COURIER_ASSIGNED\nORDER_REJECTED" as EnumOrder
  card "PaymentEventType\n----\nPAYMENT_CREATED\nPAYMENT_COMPLETED\nPAYMENT_FAILED\nPAYMENT_EXPIRED\nPAYMENT_CANCELLED" as EnumPayment
  card "DeliveryEventType\n----\nDELIVERY_ACCEPTED\nDELIVERY_PICKED_UP\nDELIVERY_IN_TRANSIT\nDELIVERY_DELIVERED\nDELIVERY_FAILED" as EnumDelivery
  card "DeliveryOfferEventType\n----\nJOB_OFFERED\nJOB_ACCEPTED\nJOB_REJECTED\nJOB_EXPIRED" as EnumOffer
}

' =======================
' BACKEND
' =======================

package "Backend (Laravel 11 / PHP 8.3)" as BE {
  component "OrderService\n#[Transactional]" as OrderSvc
  component "DeliveryService\n#[Transactional]" as DeliverySvc
  component "PaymentService\n#[Transactional]" as PaymentSvc
  database "order_events\npayment_events\ndelivery_events" as EventsTable
  database "outbox_events" as Outbox
  component "PublishOutboxEventJob\n(queue worker)" as Worker
  component "Laravel Event System\n(DomainEventBroadcasted,\nCourierPositionUpdated,\nUserNotificationCreated,\nChatMessageSent)" as Events
  component "Listener:\nDispatchSocketMessage" as Listener
  component "SocketMessageDispatcher\n+ *SocketHandler" as Dispatcher
  component "GatewayClientSocketPusher" as Pusher
  component "GatewayWorker\n(Workerman)" as Gateway
}

OrderSvc -down-> EventsTable : persist event\n(audit log)
DeliverySvc -down-> EventsTable : persist event
PaymentSvc -down-> EventsTable : persist event

OrderSvc -down-> Outbox : enqueue('order', id, type, payload)
DeliverySvc -down-> Outbox : enqueue('delivery', id, type, payload)
PaymentSvc -down-> Outbox : enqueue('payment', id, type, payload)

Worker -up-> Outbox : SELECT status=PENDING\nORDER BY next_attempt_at
Worker -right-> Events : Event::dispatch(...)
Events -right-> Listener : subscribed
Listener -down-> Dispatcher : forward(event)
Dispatcher -down-> Pusher : handle(payload, channels)
Pusher -down-> Gateway : pushToChannel(channel, msg)

note left of Outbox #LightYellow
  Outbox Pattern:
  insercao na mesma TX
  que altera o estado.
  Garante atomicidade entre
  persistencia e publicacao.
end note

note right of Worker #LightCyan
  Worker em background com
  retry e backoff.
  Idempotencia garantida via
  aggregate_id + event_name
  + created_at no payload.
end note

' Direct shortcut for tracking
DeliverySvc -[#green,dashed]-> Pusher : CourierPositionUpdated\n(direct, sem outbox)

' =======================
' CANAIS WEBSOCKET
' =======================

package "Canais WebSocket (GatewayWorker)" as Channels {
  rectangle "customer.{userId}.orders" as ChCustomer
  rectangle "restaurant.{restaurantId}.orders" as ChRest
  rectangle "order.{orderId}.tracking" as ChTrack
  rectangle "courier.{courierId}.jobs" as ChJobs
  rectangle "user.{userId}.notifications" as ChNotif
  rectangle "chat.{chatId}" as ChChat
}

Gateway --> ChCustomer
Gateway --> ChRest
Gateway --> ChTrack
Gateway --> ChJobs
Gateway --> ChNotif
Gateway --> ChChat

' =======================
' CLIENTES
' =======================

package "Frontend Web (React/Vite)" as Web {
  component "Apollo Client\n(GraphQL HTTP)" as ApolloW
  component "Realtime Service\n(services/realtime/)" as RTW
  component "RestaurantOrdersQueue\nRestaurantOrderDetail\nRestaurantChat" as RestUI
}

package "Frontend Mobile (React Native/Expo)" as Mobile {
  component "GraphQL Client" as ApolloM
  component "Realtime Service\n(WebSocket nativo)" as RTM
  component "CustomerAppScreen\n(TrackingScreen)" as CustApp
  component "CourierAppScreen\n(JOB_OFFERED listener)" as CourierApp
}

ChRest --> RTW : subscribe
ChCustomer --> RTM
ChTrack --> RTM
ChTrack --> RTW : (web tracking opcional)
ChJobs --> RTM
ChNotif --> RTW
ChNotif --> RTM
ChChat --> RTW
ChChat --> RTM

RTW --> RestUI
RTM --> CustApp
RTM --> CourierApp

ApolloW -.-> BE : queries / mutations\n(HTTP GraphQL)
ApolloM -.-> BE : queries / mutations\n(HTTP GraphQL)

@enduml
