@startuml FastBite_Seq_Estafeta_Tracking

skinparam shadowing false
actor Estafeta
participant "Mobile\nCourierAppScreen" as CourierApp
participant "GraphQL\nDelivery/Tracking Mutations" as GQL
participant "DeliveryService" as DeliverySvc
participant "CourierService" as CourierSvc
participant "TrackingService" as TrackingSvc
participant "OrderService" as OrderSvc
participant "OutboxService" as Outbox
participant "Repositories" as Repos
participant "GatewayWorker" as GW
participant "Mobile Cliente" as CustomerApp
participant "Web Restaurante" as RestaurantWeb

Estafeta -> CourierApp: aceita oferta
CourierApp -> GQL: mutation acceptDeliveryOffer(offer_id)
GQL -> DeliverySvc: acceptDeliveryOffer(offer_id)
DeliverySvc -> Repos: offer PENDING -> ACCEPTED
DeliverySvc -> Repos: delivery.courier_id = courierId
DeliverySvc -> Repos: expira outras ofertas pendentes
DeliverySvc -> CourierSvc: status AVAILABLE -> BUSY
DeliverySvc -> Repos: delivery_events DELIVERY_ACCEPTED
DeliverySvc -> Outbox: enqueue DELIVERY_ACCEPTED
DeliverySvc -> OrderSvc: recordCourierAssignedToOrder(order)
OrderSvc -> Repos: order PENDING -> COURIER_ASSIGNED
OrderSvc -> Repos: order_events ORDER_COURIER_ASSIGNED
OrderSvc -> Outbox: enqueue ORDER_COURIER_ASSIGNED
DeliverySvc -> Outbox: enqueue JOB_ACCEPTED
Outbox -> GW: ORDER_COURIER_ASSIGNED
GW -> CustomerApp: order.{orderId}.tracking
GW -> CustomerApp: customer.{customerId}.orders
GW -> RestaurantWeb: restaurant.{restaurantId}.orders
GW -> CourierApp: courier.{courierId}.jobs

Estafeta -> CourierApp: recolhe pedido
CourierApp -> GQL: mutation markDeliveryPickedUp(delivery_id, courier_id)
GQL -> DeliverySvc: markDeliveryPickedUp(delivery_id, courier_id)
DeliverySvc -> Repos: delivery PENDING -> PICKED_UP
DeliverySvc -> Repos: delivery_events DELIVERY_PICKED_UP
DeliverySvc -> Outbox: enqueue DELIVERY_PICKED_UP
DeliverySvc -> OrderSvc: recordOrderPickedUp(order)
OrderSvc -> Repos: order_events ORDER_PICKED_UP
OrderSvc -> Outbox: enqueue ORDER_PICKED_UP
Outbox -> GW: ORDER_PICKED_UP
GW -> CustomerApp: order.{orderId}.tracking
GW -> CustomerApp: customer.{customerId}.orders
GW -> RestaurantWeb: restaurant.{restaurantId}.orders

Estafeta -> CourierApp: inicia caminho para cliente
CourierApp -> GQL: mutation markDeliveryInTransit(delivery_id, courier_id)
GQL -> DeliverySvc: markDeliveryInTransit(delivery_id, courier_id)
DeliverySvc -> Repos: delivery PICKED_UP -> IN_TRANSIT
DeliverySvc -> Repos: delivery_events DELIVERY_IN_TRANSIT
DeliverySvc -> Outbox: enqueue DELIVERY_IN_TRANSIT
DeliverySvc -> OrderSvc: markOrderOutForDelivery(order)
OrderSvc -> Repos: order READY -> OUT_FOR_DELIVERY
OrderSvc -> Outbox: enqueue ORDER_OUT_FOR_DELIVERY
Outbox -> GW: ORDER_OUT_FOR_DELIVERY
GW -> CustomerApp: order.{orderId}.tracking
GW -> CustomerApp: customer.{customerId}.orders
GW -> RestaurantWeb: restaurant.{restaurantId}.orders

Estafeta -> CourierApp: entrega concluida
CourierApp -> GQL: mutation markDeliveryDelivered(delivery_id, courier_id)
GQL -> DeliverySvc: markDeliveryDelivered(delivery_id, courier_id)
DeliverySvc -> Repos: delivery IN_TRANSIT -> DELIVERED
DeliverySvc -> Repos: delivery_events DELIVERY_DELIVERED
DeliverySvc -> Outbox: enqueue DELIVERY_DELIVERED
DeliverySvc -> OrderSvc: markOrderDelivered(order)
OrderSvc -> Repos: order OUT_FOR_DELIVERY -> DELIVERED
OrderSvc -> Outbox: enqueue ORDER_DELIVERED
DeliverySvc -> CourierSvc: status BUSY -> AVAILABLE
Outbox -> GW: ORDER_DELIVERED
GW -> CustomerApp: order.{orderId}.tracking
GW -> CustomerApp: customer.{customerId}.orders
GW -> RestaurantWeb: restaurant.{restaurantId}.orders


@enduml
