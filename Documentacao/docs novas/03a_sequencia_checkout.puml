@startuml FastBite_Seq_Checkout

skinparam shadowing false
actor Cliente
participant "Mobile\nCustomerAppScreen" as Mobile
participant "GraphQL\nOrderQueries/OrderMutations" as GQL
participant "OrderService" as OrderSvc
participant "OrderPricingService" as Pricing
participant "DeliveryService" as DeliverySvc
participant "OutboxService" as Outbox
participant "Queue" as Queue
participant "Repositories" as Repos
participant "GatewayWorker\nvia PublishOutboxEventJob" as GW
participant "Web Restaurante" as RestaurantWeb

Cliente -> Mobile: finaliza carrinho
Mobile -> GQL: query previewCheckout(input)
GQL -> OrderSvc: previewCheckout(userId, cartId, addressId, coupon)
OrderSvc -> Repos: carrega carrinho, restaurante e morada
OrderSvc -> Pricing: calcula subtotal, entrega, descontos e total
Pricing --> GQL: CheckoutPreview
GQL --> Mobile: totais e descontos

Cliente -> Mobile: confirma checkout
Mobile -> GQL: mutation checkoutOrder(input)
GQL -> OrderSvc: checkoutOrder(userId, CheckoutDTO)
OrderSvc -> Repos: cria order PENDING, items e address snapshot
OrderSvc -> Repos: cria order_discounts quando aplicável


OrderSvc -> Repos: cria payment PENDING
OrderSvc -> Repos: order_events ORDER_CREATED
OrderSvc -> Repos: payment_events PAYMENT_CREATED
OrderSvc -> Outbox: enqueue ORDER_CREATED
Outbox -> Queue: PublishOutboxEventJob(order_created)
OrderSvc -> Queue: ExpirePendingPaymentJob(delay expired_at)

... pagamento confirmado ...

OrderSvc -> Repos: order_events ORDER_PAYMENT_COMPLETED
OrderSvc -> Outbox: enqueue ORDER_PAYMENT_COMPLETED
Outbox -> Queue: PublishOutboxEventJob(order_payment_completed)
OrderSvc -> Repos: payment_events PAYMENT_COMPLETED
OrderSvc -> DeliverySvc: createDeliveryForOrder(orderId, deliveryFee)
DeliverySvc -> Repos: cria delivery PENDING
OrderSvc -> Queue: AssignCourierToDeliveryJob(deliveryId)

OrderSvc -> Repos: limpa carrinho
OrderSvc -> GQL: order PENDING + payment
GQL --> Mobile: order PENDING + payment

Queue -> Outbox: PublishOutboxEventJob publica eventos de outbox
Outbox -> GW: ORDER_CREATED + ORDER_PAYMENT_COMPLETED
GW -> Mobile: order.{orderId}.tracking
GW -> Mobile: customer.{customerId}.orders
GW -> RestaurantWeb: restaurant.{restaurantId}.orders

Queue -> DeliverySvc: AssignCourierToDeliveryJob
DeliverySvc -> Repos: procura estafeta disponivel
DeliverySvc -> Repos: cria delivery_offer PENDING
DeliverySvc -> Outbox: enqueue JOB_OFFERED
Outbox -> Queue: PublishOutboxEventJob(job_offered)

@enduml
