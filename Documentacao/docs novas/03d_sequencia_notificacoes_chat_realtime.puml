@startuml FastBite_Seq_Notificacoes_Chat_Realtime
title FastBite - Sequencia: Notificacoes, push, chat e realtime

skinparam shadowing false
participant "Service de dominio\n(Order/Payment/Delivery/Chat)" as DomainSvc
participant "OutboxService" as Outbox
participant "NotificationEventRecorded" as NotificationEvent
participant "CreateNotificationFromDomainEvent" as NotificationListener
participant "NotificationService" as NotificationSvc
participant "PublishOutboxEventJob" as PublishJob
participant "DispatchNotificationChannelsJob" as NotifyChannelsJob
participant "SendPushNotificationJob" as PushJob
participant "DispatchSocketMessage" as SocketListener
participant "SocketMessageDispatcher" as Dispatcher
participant "GatewayClientSocketPusher" as Pusher
database "PostgreSQL" as DB
participant "GatewayWorker" as GW
participant "Frontend Web/Mobile" as Client
participant "Expo Push API" as Expo

== Evento de dominio ==
DomainSvc -> DB: persiste evento/auditoria
DomainSvc -> Outbox: enqueue(eventName, payload.channels)
DomainSvc -> NotificationEvent: event(eventType, payload)
NotificationEvent -> NotificationListener: handle()
NotificationListener -> NotificationSvc: createFromEvent(eventType, payload)
NotificationSvc -> DB: cria notifications
NotificationSvc -> Outbox: enqueue USER_NOTIFICATION_CREATED

== Publicacao realtime ==
PublishJob -> DB: carrega outbox_events PENDING
PublishJob -> DB: marca PROCESSING
PublishJob -> SocketListener: event DomainEventBroadcasted/UserNotificationCreated
SocketListener -> Dispatcher: dispatch(event)
Dispatcher -> Pusher: push(channel, message)
Pusher -> GW: GatewayWorker sendToGroup/sendToUid
GW -> Client: mensagens nos topicos subscritos
PublishJob -> DB: marca PUBLISHED

== Push notification ==
PublishJob -> NotifyChannelsJob: dispatch(notificationId, payload)
NotifyChannelsJob -> NotificationSvc: dispatchNotificationChannels(...)
NotificationSvc -> DB: procura user_push_tokens ativos
NotificationSvc -> PushJob: dispatch por token
PushJob -> NotificationSvc: sendPushNotification(token, payload)
NotificationSvc -> Expo: POST push notification

== Chat ==
Client -> DomainSvc: mutation sendMessage(chatId, senderId, content)
DomainSvc -> DB: cria messages
DomainSvc -> Outbox: enqueue CHAT_MESSAGE_SENT
PublishJob -> SocketListener: event ChatMessageSent
SocketListener -> Dispatcher: dispatch(event)
Dispatcher -> Pusher: push chat.{chatId}
GW -> Client: nova mensagem em tempo real

@enduml
