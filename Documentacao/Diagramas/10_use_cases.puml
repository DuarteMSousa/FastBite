@startuml FastBite_UseCases
title FastBite — Diagrama de Casos de Uso

skinparam shadowing false
skinparam usecase {
  BackgroundColor #FAFAFA
  BorderColor #555
}
left to right direction

actor "Cliente" as Customer
actor "Restaurante\n(Gestor de Cadeia /\nGestor Local)" as Restaurant
actor "Estafeta" as Courier
actor "Sistema\n(orquestrador)" as System

rectangle "FastBite" {
  usecase "UC-01\nPesquisar\nRestaurantes" as UC1
  usecase "UC-02\nGerir Carrinho" as UC2
  usecase "UC-03\nSubmeter Encomenda\n(Checkout)" as UC3
  usecase "UC-04\nPagar Encomenda" as UC4
  usecase "UC-05\nAceitar / Rejeitar\nEncomenda" as UC5
  usecase "UC-06\nPreparar Itens\n(Cozinha Virtual)" as UC6
  usecase "UC-07\nAtribuir Estafeta\n(Ofertas Temporizadas)" as UC7
  usecase "UC-08\nAceitar / Rejeitar\nOferta de Entrega" as UC8
  usecase "UC-09\nTransmitir\nLocalizacao GPS" as UC9
  usecase "UC-10\nAcompanhar\nTracking" as UC10
  usecase "UC-11\nComunicar via\nChat" as UC11
  usecase "UC-12\nAvaliar Servico" as UC12
  usecase "UC-13\nGerir Catalogo,\nCampanhas e\nCupoes" as UC13
  usecase "UC-14\nNotificar\nUtilizadores" as UC14
}

Customer --> UC1
Customer --> UC2
Customer --> UC3
Customer --> UC4
Customer --> UC10
Customer --> UC11
Customer --> UC12

Restaurant --> UC5
Restaurant --> UC6
Restaurant --> UC11
Restaurant --> UC13

Courier --> UC8
Courier --> UC9
Courier --> UC11

System --> UC4
System --> UC7
System --> UC14

UC3 ..> UC4 : <<include>>
UC5 ..> UC7 : <<include>>
UC8 ..> UC9 : <<extend>>
UC9 ..> UC10 : <<extend>>

note bottom of UC7 #LightYellow
  Atribuicao por ofertas
  temporizadas (TTL 30s).
  Ate 3 tentativas antes
  de FAILED.
end note

note right of UC4 #LightCyan
  Pagamentos simulados:
  CARD / MBWAY / CASH
end note

@enduml
