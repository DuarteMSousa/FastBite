@startuml FastBite_State_DeliveryOffer
title FastBite - Estados de Oferta de Entrega (DeliveryOfferStatus)

skinparam shadowing false

[*] --> PENDING : sistema escolhe um estafeta disponível\ne envia uma oferta temporária

PENDING --> ACCEPTED : estafeta aceita a oferta\ndentro do prazo
PENDING --> REJECTED : estafeta rejeita a oferta\ne o sistema tenta outro
PENDING --> EXPIRED : prazo termina sem resposta\ndo estafeta

ACCEPTED --> [*]
REJECTED --> [*]
EXPIRED --> [*]

note right of REJECTED
  Depois de rejeitada ou expirada,
  o sistema tenta encontrar outro estafeta.
end note

@enduml
