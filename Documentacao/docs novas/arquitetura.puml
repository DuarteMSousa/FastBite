@startuml
left to right direction
skinparam componentStyle rectangle
skinparam shadowing false

actor "Gestor do\nRestaurante" as Gestor
actor "Cliente" as Cliente
actor "Estafeta" as Estafeta

node "Frontend Web\nReact / Vite" as Web
node "Frontend Mobile\nReact Native / Expo" as Mobile

rectangle "Backend\nLaravel 11 / PHP 8.3" as Backend {
  component "API GraphQL\nLighthouse" as GraphQL
  component "Services/Repositories\nGestão de estados\nOrquestração de eventos" as Business
  component "Sistema de Filas\ne Jobs" as Jobs
  component "Outbox de Eventos" as Outbox
}

node "Servidor WebSocket\nWorkerman / GatewayWorker" as WebSocket
database "Base de Dados\nPostgreSQL" as DB
queue "Fila de Jobs" as Queue

Gestor --> Web
Cliente --> Mobile
Estafeta --> Mobile

Web --> GraphQL : pedidos HTTP / GraphQL
Mobile --> GraphQL : pedidos HTTP / GraphQL

GraphQL --> Business
Business --> DB : leitura / escrita
Business --> Outbox : registo de eventos
Business --> Queue : criação de jobs

Queue --> Jobs : processamento assíncrono
Jobs --> DB : atualização de estados
Jobs --> Outbox : publicação de eventos

Outbox --> WebSocket : eventos em tempo real
WebSocket --> Web : atualizações live
WebSocket --> Mobile : atualizações live

@enduml